# 复制为 .env 后填写。.env 已被 .gitignore 排除，不会进仓库。
# 非密钥配置写在 config.toml / config.local.toml；这里的同名项会覆盖它们。

# 兜底 API 的密钥（只能放这里或环境变量）
FALLBACK_API_KEY=
# 兜底模型名，以 DeepSeek 文档当前列出的为准
FALLBACK_MODEL=

# QQ 机器人账号（NapCat 登录的小号）
QQ_BOT_ACCOUNT=
# NapCat WebSocket 服务的 token 与地址
NAPCAT_TOKEN=
QQ_WS_URL=ws://127.0.0.1:3001
# 你自己的 QQ 号（可多个，逗号分隔）：确认绑定、查看状态
QQ_OWNER_ACCOUNTS=
# 允许她进入的群号（逗号分隔）；留空则只私聊
QQ_GROUPS=

# 一键启停脚本用：NapCat 所在目录、控制台端口（默认 8765）
NAPCAT_DIR=E:\07\NapCat.Shell.Windows.OneKey\NapCat.52230.Shell
CONSOLE_PORT=8765
